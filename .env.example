# API Configuration
# Base URL for the backend API
NEXT_PUBLIC_API_BASE_URL=https://staging-api.icadpay.com

# Permit verification (reg & cert backend) — separate from main API. Used for onboarding (Seafarer Employer / Training Institution).
# NEXT_PUBLIC_PERMIT_VERIFY_BASE_URL=https://reg-cert-api.example.com

# Permit verification: set to "true" to use mock responses instead of the API (local testing only)
# NEXT_PUBLIC_MOCK_PERMIT_VERIFY=true

# OAuth Client Credentials
# These are required for authentication
# Replace these with your actual client credentials from the backend team
NEXT_PUBLIC_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_CLIENT_SECRET=your_client_secret_here

# OAuth Grant Type (defaults to "password" if not set)
NEXT_PUBLIC_GRANT_TYPE=password

# IMS URL Configuration
# URL for the IMS application (used for "Return to IMS" link and SSO redirects)
# Defaults to https://ims.mems.ng if not set
NEXT_PUBLIC_IMS_URL=https://ims.mems.ng

# Where to send users after session expiry (defaults to NEXT_PUBLIC_IMS_URL)
# NEXT_PUBLIC_IMS_LOGOUT_URL=https://ims.mems.ng

# Local dev (ports are fixed in package.json: IMS :3000, Seafarer :3001):
# NEXT_PUBLIC_IMS_URL=http://localhost:3000
# NEXT_PUBLIC_IMS_LOGOUT_URL=http://localhost:3000
# Set the Seafarer workspace URL in IMS Admin to http://localhost:3001
# Optional explicit override (wins over auto-detection on localhost):
# NEXT_PUBLIC_IMS_LOCAL_URL=http://localhost:3000
